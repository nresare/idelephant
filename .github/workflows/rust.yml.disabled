name: Rust

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

env:
  CARGO_TERM_COLOR: always

jobs:
  build:

    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3

    - uses: Swatinem/rust-cache@v2

    - name: Format check
      run: cargo fmt --all --check

    - name: Run tests
      run: cargo test --workspace --locked --verbose

    - name: Clippy check
      run: cargo clippy --workspace --all-targets --locked --no-deps
