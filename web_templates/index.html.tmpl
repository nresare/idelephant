<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>idElephant signup and login page</title>
<link rel="stylesheet" href="/static/index.css">
</head>
<body>
<main>
{{#if admin}}
<header class="admin-topbar"><a class="brand" href="/">idElephant 🐘</a><span class="admin-label">Admin</span><span class="account-email">{{identity.email}}</span></header>
<nav class="admin-nav" aria-label="Admin pages"><a aria-current="page" href="/">Overview</a><a href="/admin/apps">App registrations</a><a href="/admin/groups">Groups</a></nav>
{{/if}}
<section class="hero">
<p class="eyebrow">Your favourite identity provider</p>
{{#if identity}}
<h1>Welcome back</h1>
<p class="lede">You are signed in as <strong>{{identity.email}}</strong>.{{#if admin}} Choose what you would like to manage.{{/if}}</p>
{{else}}
<h1>idElephant 🐘</h1>
<p class="lede">If you don't have an account, talk to admin to get invited.</p>
{{/if}}
</section>

{{#if admin}}
<section class="admin-cards" aria-label="Administration">
<a class="admin-card" href="/admin/apps"><h2>App registrations</h2><p>Register sign-in clients, edit redirect URIs, and retire apps.</p><span>Manage apps →</span></a>
<a class="admin-card" href="/admin/groups"><h2>Groups</h2><p>Organize people into groups and manage membership.</p><span>Manage groups →</span></a>
</section>
{{/if}}

<section class="panel" aria-labelledby="session-title">
<div id="error-box" class="error-box" hidden role="alert" aria-live="polite">
<button id="error-close" class="error-close" type="button" aria-label="Close error message">x</button>
<div id="error-message"></div>
</div>

<h2 id="session-title">{{#if identity}}Current session{{/if}}</h2>
{{#if identity}}
<p class="action-row"><input id="logout" type="submit" value="log out"></p>
{{else}}
<p class="action-row"><input id="authenticate" type="submit" value="log in"></p>
{{/if}}
</section>
</main>
<script src="/static/script.js"></script>
<script>
window.idElephantPendingAuthorization = {{#if pending_authorization}}true{{else}}false{{/if}};
document.getElementById("error-close").addEventListener("click", hideError)
{{#if identity}}
document.getElementById("logout").addEventListener("click", logout)
{{else}}
document.getElementById("authenticate").addEventListener("click", authenticate)
{{/if}}
</script>
</body>
</html>
