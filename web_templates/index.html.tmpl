<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>idElephant signup and login page</title>
<link rel="stylesheet" href="/static/index.css">
</head>
<body>
<main>
<section class="hero">
<p class="eyebrow">Your favourite identity provider</p>
{{#if identity}}
<h1>Welcome back</h1>
<p class="lede">You are signed in as <strong>{{identity.email}}</strong>.</p>
{{else}}
<h1>idElephant 🐘</h1>
<p class="lede">If you don't have an account, talk to admin to get invited.</p>
{{/if}}
</section>

<section class="panel" aria-labelledby="session-title">
<div id="error-box" class="error-box" hidden role="alert" aria-live="polite">
<button id="error-close" class="error-close" type="button" aria-label="Close error message">x</button>
<div id="error-message"></div>
</div>

<h2 id="session-title">{{#if identity}}Current session{{/if}}</h2>
{{#if identity}}
<p class="action-row"><input id="logout" type="submit" value="log out"></p>
{{else}}
<p class="action-row"><input id="authenticate" type="submit" value="log in"></p>
{{/if}}
</section>
{{#if admin}}
<section class="panel" aria-labelledby="apps-title">
<h2 id="apps-title">App registrations</h2>
<p class="muted">Manage the apps that can use idElephant for sign-in.</p>
<p id="apps-status" role="status" aria-live="polite"></p>
<div id="apps-list"></div>
<h3 id="app-form-title">Register an app</h3>
<form id="app-form">
<label for="app-client-id">Client ID</label>
<input id="app-client-id" name="client_id" required>
<label for="app-name">App name</label>
<input id="app-name" name="name" required>
<label for="app-redirects">Redirect URIs (one per line)</label>
<textarea id="app-redirects" name="redirect_uris" rows="4" required aria-describedby="redirect-help"></textarea>
<p id="redirect-help" class="muted">Enter the exact callback URLs used by your app.</p>
<div class="button-group">
<button id="app-save" type="submit">Register app</button>
<button id="app-cancel" type="button" hidden>Cancel editing</button>
</div>
</form>
</section>
{{/if}}
</main>
<script src="/static/script.js"></script>
<script>
window.idElephantPendingAuthorization = {{#if pending_authorization}}true{{else}}false{{/if}};
document.getElementById("error-close").addEventListener("click", hideError)
{{#if identity}}
document.getElementById("logout").addEventListener("click", logout)
{{else}}
document.getElementById("authenticate").addEventListener("click", authenticate)
{{/if}}
</script>
{{#if admin}}<script src="/static/apps.js"></script>{{/if}}
</body>
</html>
